# Verified public business destinations. Leave blank until supplied.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_SITE_URL=
# Set true only after naming clearance and approval for public launch.
NEXT_PUBLIC_LAUNCH_APPROVED=true
# Optional external enquiry backend; otherwise the built-in endpoint is detected.
NEXT_PUBLIC_ENQUIRY_ENDPOINT=
# Public PostHog browser token (phc_...), not a personal/private API key.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Use the ingestion host matching the project's region:
# EU: https://eu.i.posthog.com | US: https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=
# Optional alternative HTTPS analytics collector accepting the documented anonymous event JSON.
# No events leave the browser when blank.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# Server-only email delivery, using a verified Resend sender. Never use NEXT_PUBLIC_.
RESEND_API_KEY=
ENQUIRY_FROM=
ENQUIRY_TO=
