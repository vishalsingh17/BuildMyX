# Verified public business destinations. Leave blank until supplied.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_SITE_URL=https://build-my-x.vercel.app
# Set true only after naming clearance and approval for public launch.
NEXT_PUBLIC_LAUNCH_APPROVED=true
# Optional external enquiry backend; otherwise the built-in endpoint is detected.
NEXT_PUBLIC_ENQUIRY_ENDPOINT=
# BuildMyX public production analytics are configured in lib/site-config.ts.
# Set false to disable external analytics on a deployment.
NEXT_PUBLIC_ANALYTICS_ENABLED=true
# Optional override: public PostHog browser token (phc_...), not a personal/private API key.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Use the ingestion host matching the project's region:
# EU: https://eu.i.posthog.com | US: https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=
# Optional alternative HTTPS analytics collector accepting the documented anonymous event JSON.
# Set NEXT_PUBLIC_ANALYTICS_ENABLED=false to disable collection.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# Convex cloud development for this repository. Copy into .env.local for local work.
# Vercel production builds should use a production deployment's URLs instead.
CONVEX_DEPLOYMENT=dev:tacit-badger-38
NEXT_PUBLIC_CONVEX_URL=https://tacit-badger-38.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://tacit-badger-38.convex.site
# Private CONVEX_DEPLOY_KEY values belong in the hosting provider's secret settings.

# Next.js server: database intake URL. No email key is needed on Vercel.
ENQUIRY_CONVEX_SITE_URL=https://tacit-badger-38.convex.site
# Set false to force copy-only mode on this Next.js deployment.
ENQUIRY_ENABLED=true

# Set these in Convex dashboard -> selected deployment -> Settings -> Environment Variables.
# They are NOT public browser variables. Database saves work without Resend.
# ENQUIRY_ALLOWED_ORIGIN=https://build-my-x.vercel.app
# RESEND_API_KEY=
# ENQUIRY_FROM=
# ENQUIRY_TO=
# ENQUIRY_EMAIL_TEST_MODE=true
# RESEND_WEBHOOK_SECRET=

# Legacy HMAC metadata endpoint only; unused by the database intake flow.
# ENQUIRY_SERVICE_SECRET=
