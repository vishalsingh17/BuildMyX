{
  "name": "buildmyx",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "dev:convex": "convex dev",
    "start": "next start --hostname 0.0.0.0",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:convex",
    "test:browser": "node scripts/browser-check.mjs",
    "test:unit": "tsx --test lib/*.test.ts lib/server/*.test.ts",
    "test:convex": "vitest run"
  },
  "dependencies": {
    "@convex-dev/rate-limiter": "^0.4.3",
    "@convex-dev/resend": "^0.2.10",
    "convex": "^1.49.0",
    "next": "^16.0.0",
    "posthog-js": "^1.447.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "convex-test": "^0.0.70",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
