{
  "name": "buildmyx",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:learn && next dev --hostname 0.0.0.0",
    "setup:learn": "node scripts/setup-learning.mjs",
    "build:learn": "tsx scripts/build-learn.ts",
    "dev:learn": "npm run setup:learn && .venv/bin/zensical serve -f zensical.toml --dev-addr 0.0.0.0:8000",
    "dev:convex": "convex dev",
    "start": "next start --hostname 0.0.0.0",
    "build": "node scripts/build-website.mjs",
    "build:deploy": "tsx scripts/vercel-build.ts",
    "release:check": "tsx scripts/configure-release.ts --check",
    "release:protect": "tsx scripts/configure-release.ts --apply",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:convex",
    "test:pytorch": "node scripts/check-pytorch-examples.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "test:unit": "tsx --test lib/*.test.ts lib/server/*.test.ts scripts/*.test.*",
    "test:convex": "vitest run",
    "sync:references": "tsx scripts/sync-references.ts"
  },
  "dependencies": {
    "@convex-dev/rate-limiter": "^0.4.3",
    "@convex-dev/resend": "^0.2.10",
    "@next/env": "^16.4.6",
    "cheerio": "^1.2.0",
    "convex": "^1.49.0",
    "next": "^16.0.0",
    "posthog-js": "^1.447.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sanitize-html": "^2.18.2"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.2",
    "convex-test": "^0.0.70",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
